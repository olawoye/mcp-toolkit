{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcp-toolkit/schemas/lead",
  "title": "Lead",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "company": { "$ref": "company" },
    "contacts": { "type": "array", "items": { "$ref": "contact" } },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "stage": { "type": "string", "enum": ["discovered", "researched", "qualified", "contacted", "converted", "rejected"] },
    "buyingSignals": { "type": "array", "items": { "$ref": "buying-signal" } },
    "sources": { "type": "array", "items": { "$ref": "source-evidence" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["company"]
}
