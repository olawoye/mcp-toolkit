{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcp-toolkit/schemas/technology",
  "title": "Technology",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "category": { "type": "string" },
    "vendor": { "type": "string" },
    "version": { "type": "string" },
    "firstDetected": { "type": "string", "format": "date" },
    "lastDetected": { "type": "string", "format": "date" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["name"]
}
