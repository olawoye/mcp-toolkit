{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcp-toolkit/schemas/company",
  "title": "Company",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "domain": { "type": "string", "format": "hostname" },
    "website": { "type": "string", "format": "uri" },
    "description": { "type": "string" },
    "industry": { "type": "string" },
    "subIndustry": { "type": "string" },
    "employeeCount": { "type": "integer", "minimum": 0 },
    "employeeRange": { "type": "string" },
    "revenue": { "type": "number" },
    "revenueRange": { "type": "string" },
    "foundedYear": { "type": "integer" },
    "headquarters": { "$ref": "address" },
    "technologies": { "type": "array", "items": { "$ref": "technology" } },
    "linkedinUrl": { "type": "string", "format": "uri" },
    "twitterHandle": { "type": "string" },
    "sources": { "type": "array", "items": { "$ref": "source-evidence" } }
  },
  "required": ["name"]
}
