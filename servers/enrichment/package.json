    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mcp-toolkit/errors": "workspace:*",
    "@mcp-toolkit/logging": "workspace:*",
    "@mcp-toolkit/validation": "workspace:*",
    "@mcp-toolkit/caching": "workspace:*",
    "@mcp-toolkit/provider-hunter": "workspace:*",
    "@mcp-toolkit/provider-apollo": "workspace:*",
    "@mcp-toolkit/provider-opencorporates": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
