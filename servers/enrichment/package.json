{
  "name": "@mcp-toolkit/server-enrichment",
  "version": "0.1.0",
  "description": "MCP server for data enrichment (company, person, email, phone)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
